/**
 * Pawservation worker — binds only Pawservation's dedicated D1 + KV.
 * TOKEN_SECRET is a secret (set via `wrangler secret put TOKEN_SECRET`), never committed here.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pawservation",
  "compatibility_date": "2026-06-05",
  "main": "./server/index.ts",
  "workers_dev": true,
  // Every `wrangler versions upload` prints a shareable https://<version>-pawservation.<subdomain>.workers.dev
  // staging URL for that exact worker version, so a version can be reviewed before it's promoted
  // to the main pawservation.com route. See README.md's "Staging/preview URLs" section.
  "preview_urls": true,
  // Custom domain. workers_dev stays on for the preview_urls staging-URL feature above;
  // www can be added the same way later.
  "routes": [{ "pattern": "pawservation.com", "custom_domain": true }],
  "observability": {
    "enabled": true,
  },
  // Where a premium surface lives, published on `GET /api/:slug/config` so an embed that cannot
  // resolve a relative path — anything served from a *.workers.dev host, where the
  // `/premium/*` zone route does not apply — has an absolute origin to use instead.
  //
  // A plain var, not a secret: it is a public URL that appears in every config response.
  //
  // `premiumOrigin()` returns null unless this is an absolute origin, and the flag it accompanies
  // is UX only — the paid tier does its own server-side entitlement check on every request — so a
  // wrong value here costs a surface that will not mount, never access that should not exist.
  "vars": {
    "PREMIUM_ORIGIN": "https://pawservation.com",
  },
  // Calendar sweep: outbox re-drive + Google reconcile for every connected tenant.
  // server/index.ts exports the matching scheduled() handler.
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
  "d1_databases": [
    {
      "binding": "PAWSERVATION_DB",
      "database_name": "pawservation-db",
      // database_name is a local label wrangler resolves config entries against — not the
      // Cloudflare account's actual registered database name, which stays "pawbook-db"
      // permanently (neither `wrangler d1` nor the Cloudflare API has a rename capability).
      // database_id below is the real, unchanging identifier of the resource.
      "database_id": "db7d32b9-58a3-4d01-9da9-e840accaa3fc",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "PAWSERVATION_CACHE",
      "id": "0ff429da7602416296d626f0a441f2fa",
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Every path the worker's page() handler serves must be listed explicitly — glob "/x/*"
    // does NOT match the bare "/x", and un-listed paths bypass the worker entirely (served
    // straight off the assets layer with no CSP / X-Frame-Options at all). See server/index.ts.
    "run_worker_first": [
      "/api/*",
      "/embed/*",
      "/admin",
      "/admin/*",
      "/admin.html",
      "/demo",
      "/demo.html",
      "/setup",
      "/setup.html",
      "/llms.txt",
      "/how-it-works",
      "/about",
      "/contact",
      "/privacy",
      "/terms",
      "/request-invite",
      "/request-invite/thanks",
      // Google redirects the sitter's popup here. Nothing is emitted at this path today, so it
      // reaches the worker regardless — the entry is defensive, on the same footing as
      // "/how-it-works": a build that ever emitted an asset here would shadow the callback and
      // turn "Connect Google Calendar" into a silent, unloggable failure.
      "/oauth/google/callback",
    ],
  },
}
